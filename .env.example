# Copy to .env and fill in. NEVER commit real secrets.
# Simulation mode (default) needs nothing else — it touches no real service.

# Your relay station (Veloera / New-API compatible). Required for real mode.
RELAY_API_BASE=
RELAY_ADMIN_KEY=
RELAY_PROBE_TIMEOUT_S=10

# 1 = simulation mode (virtual channels, key-leak scenario). 0 = real mode.
SIMULATION_MODE=1

# Anomaly detector: open-weight model via Ollama. Falls back to built-in
# heuristic rules automatically when Ollama is unreachable.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# 1 = skip Ollama entirely and always use the heuristic classifier.
DETECTOR_FORCE_HEURISTIC=0

# Quarantine policy. Deterministic thresholds — the model only classifies,
# it never decides anything money-adjacent.
QUARANTINE_SCORE_THRESHOLD=0.75
QUARANTINE_CONSECUTIVE_WINDOWS=2
WINDOW_SECONDS=300

# Telegram alerts (optional). Without these, alerts go to the local log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Quiet hours: non-critical alerts are held until morning.
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# Storage / server
DB_PATH=relaypilot.db
HOST=127.0.0.1
PORT=8099
